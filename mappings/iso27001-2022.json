{
  "framework": "ISO/IEC 27001:2022 Annex A",
  "short": "ISO 27001",
  "verified": false,
  "note": "Nur Kennungen und Kurztitel in Anlehnung an die Norm, kein Normtext. Kennungen und Titel vor Freigabe gegen die Norm prüfen.",
  "controls": {
    "5.15": { "title": "Zugangssteuerung", "rules": ["hba.open_to_all", "hba.superuser_remote", "db.public_schema_create", "db.public_temp", "roles.bypassrls", "os.pgdata_permissions", "db.public_connect", "db.catalog_visibility"] },
    "5.17": { "title": "Authentisierungsinformationen", "rules": ["auth.password_encryption", "auth.md5_passwords", "auth.weak_passwords", "auth.password_policy", "client.service_file_password", "client.pgpass_acl", "client.pgpass_mode", "client.pgpass_location", "client.pgpass_superuser", "client.pgpass_shadowed", "client.pgpass_loopback", "client.env_pgpassword", "client.secrets_in_files"] },
    "8.2": { "title": "Privilegierte Zugriffsrechte", "rules": ["roles.extra_superusers", "roles.server_file_access", "roles.createrole", "roles.bypassrls", "code.secdef_search_path", "code.untrusted_languages", "os.service_account"] },
    "8.3": { "title": "Einschränkung des Informationszugangs", "rules": ["db.public_schema_create", "code.lo_compat_privileges", "roles.bypassrls", "os.pgdata_permissions", "os.config_permissions", "os.log_permissions", "os.umask", "db.public_connect"] },
    "8.5": { "title": "Sichere Authentisierung", "rules": ["hba.trust", "hba.cleartext_password", "hba.md5_method", "auth.weak_passwords", "auth.authentication_timeout", "auth.auth_delay", "auth.password_encryption", "os.service_unit"] },
    "8.6": { "title": "Kapazitätssteuerung", "rules": ["avail.temp_file_limit", "avail.slot_wal_keep", "avail.inactive_slots", "sess.idle_in_transaction", "log.directory_outside_pgdata", "os.log_own_volume", "os.disk_free"] },
    "8.8": { "title": "Handhabung technischer Schwachstellen", "rules": ["patch.supported_major", "patch.catalog_current", "os.package_source"] },
    "8.9": { "title": "Konfigurationsmanagement", "rules": ["roles.allow_alter_system", "hba.errors", "conf.role_db_overrides", "code.preload_libraries", "code.extensions", "os.config_permissions", "os.service_unit"] },
    "8.13": { "title": "Sicherung von Information", "rules": ["avail.archive_enabled", "avail.archiver_failing"] },
    "8.15": { "title": "Protokollierung", "rules": ["log.collector", "log.connections", "log.disconnections", "log.line_prefix", "log.statement_ddl", "log.pgaudit", "log.parameter_length", "log.debug_print", "log.file_mode", "os.log_permissions"] },
    "8.20": { "title": "Netzwerksicherheit", "rules": ["net.listen_addresses", "hba.open_to_all", "hba.host_without_tls", "os.socket_permissions"] },
    "8.24": { "title": "Verwendung von Kryptografie", "rules": ["tls.ssl_enabled", "tls.min_protocol", "hba.host_without_tls", "auth.password_encryption", "os.ssl_key_permissions", "client.cert_key_permissions", "client.cert_expiry"] },
    "8.28": { "title": "Sichere Programmierung", "rules": ["code.secdef_search_path"] }
  }
}
